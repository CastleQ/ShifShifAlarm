<Window x:Class="EasyAlarm.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="쉽쉽알람 — 설정"
        Width="460" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F8FA">

    <Window.Resources>

        <!-- 구역 제목 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 설명 문구 -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="24,2,0,0"/>
        </Style>

        <!-- 체크박스 -->
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 일반 버튼: 테두리 없는 장미색 계열 -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A01F33"/>
            <Setter Property="Background" Value="#14A01F33"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#28A01F33"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#BBBBBB"/>
                                <Setter TargetName="Bg" Property="Background" Value="#11000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─── 구글 캘린더 연동 ─── -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="18,16"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="☁ 구글 캘린더 연동" Style="{StaticResource SectionTitle}"/>

                <CheckBox x:Name="SyncEnabledCheck"
                          Content="동기화 사용"
                          Checked="SyncEnabledCheck_Changed"
                          Unchecked="SyncEnabledCheck_Changed"/>
                <TextBlock Text="알람을 등록하면 구글 캘린더에도 자동으로 일정이 추가됩니다. 휴대폰에서도 알림을 받을 수 있어요."
                           Style="{StaticResource HintText}"/>

                <!-- 연결 상태 -->
                <Border Background="#F4F6F8"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="상태 확인 중..."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#424242"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ConnectButton"
                                    Content="계정 연결"
                                    Style="{StaticResource SoftButton}"
                                    Click="ConnectButton_Click"/>
                            <Button x:Name="DisconnectButton"
                                    Content="연결 해제"
                                    Style="{StaticResource SoftButton}"
                                    Margin="8,0,0,0"
                                    Click="DisconnectButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 대상 캘린더 -->
                <TextBlock Text="대상 캘린더"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#424242"
                           Margin="0,16,0,6"/>

                <ComboBox x:Name="CalendarCombo"
                          FontSize="13"
                          Padding="8,5"
                          SelectionChanged="CalendarCombo_SelectionChanged"/>

                <TextBlock Text="변경하면 이후에 등록되는 알람부터 적용됩니다."
                           Style="{StaticResource HintText}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ─── 일반 ─── -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="18,16">
            <StackPanel>
                <TextBlock Text="⚙ 일반" Style="{StaticResource SectionTitle}"/>

                <CheckBox x:Name="StartupCheck"
                          Content="윈도우 시작 시 자동 실행"
                          Checked="StartupCheck_Changed"
                          Unchecked="StartupCheck_Changed"/>
                <TextBlock x:Name="StartupHint"
                           Text="PC를 켜면 쉽쉽알람이 자동으로 대기합니다."
                           Style="{StaticResource HintText}"/>

                <CheckBox x:Name="Clock24Check"
                          Content="24시간제로 표시"
                          Margin="0,14,0,0"
                          Checked="Clock24Check_Changed"
                          Unchecked="Clock24Check_Changed"/>
                <TextBlock x:Name="ClockHint"
                           Text="예: 14:30"
                           Style="{StaticResource HintText}"/>
            </StackPanel>
        </Border>

        <!-- ─── 하단 ─── -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="쉽쉽알람 (ShifShif Alarm)"
                       FontSize="11"
                       Foreground="#AAAAAA"
                       VerticalAlignment="Center"/>

            <Button Content="닫기"
                    Style="{StaticResource SoftButton}"
                    HorizontalAlignment="Right"
                    Padding="20,6"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>