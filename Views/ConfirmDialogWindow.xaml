<Window x:Class="EasyAlarm.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="쉽쉽알람 확인"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- [예] 버튼: 앱 포인트 색(장미색) 채움 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#A01F33"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#87192B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#87192B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- [아니오] 버튼: 테두리 없는 회색 -->
        <Style x:Key="QuietButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#424242"/>
                                <Setter TargetName="Bg" Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 바깥 여백은 그림자가 잘리지 않도록 비워 둡니다 -->
    <Border Background="#FFFFFF"
            CornerRadius="12"
            Margin="14"
            Padding="24,20,24,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28"/>
        </Border.Effect>

        <StackPanel>

            <!-- 제목 -->
            <TextBlock x:Name="TitleText"
                       Text=""
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#212121"
                       TextWrapping="Wrap"/>

            <!-- 본문 (일반) -->
            <TextBlock x:Name="MessageText"
                       Text=""
                       FontSize="13"
                       Foreground="#616161"
                       Margin="0,10,0,0"
                       LineHeight="19"
                       TextWrapping="Wrap"/>

            <!-- 강조 줄: 할일명·알람 내용 (볼드) -->
            <Border x:Name="HighlightBox"
                    Background="#F7F7F7"
                    CornerRadius="8"
                    Padding="12,9"
                    Margin="0,12,0,0">
                <TextBlock x:Name="HighlightText"
                           Text=""
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#212121"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- 버튼 줄 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">

                <Button x:Name="NoButton"
                        Content="아니오"
                        IsCancel="True"
                        Style="{StaticResource QuietButtonStyle}"/>

                <Button x:Name="YesButton"
                        Content="예"
                        IsDefault="True"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="YesButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
