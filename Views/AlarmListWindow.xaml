<Window x:Class="EasyAlarm.Views.AlarmListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="쉽쉽알람 — 할일 목록"
        Width="440" Height="600"
        MinWidth="380" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- ── 삭제 버튼 스타일: 테두리 없음, 평소 연한 장미색, 호버 시 #A01F33 ── -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D8A9B0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#A01F33"/>
                                <Setter TargetName="Bg" Property="Background" Value="#14A01F33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 스크롤바가 내용 '위에 겹쳐' 뜨는 오버레이 방식 ScrollViewer.
             스크롤바는 스타일 없이 이 템플릿 안에서 '직접' 3px 두께로 조립합니다.
             (직접 지정한 로컬 값은 테마/기본 스타일 등 무엇에도 밀리지 않는 최우선 값) -->
        <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="{TemplateBinding Padding}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Orientation="Vertical"
                                       HorizontalAlignment="Right"
                                       Width="3"
                                       MinWidth="3"
                                       Margin="0,4,2,4"
                                       Opacity="0"
                                       Background="Transparent"
                                       Maximum="{Binding ScrollableHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                       ViewportSize="{Binding ViewportHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <!-- ▲▼ 버튼 없이 트랙과 손잡이(Thumb)만 -->
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Width="3"
                                                                    Background="#66707070"
                                                                    CornerRadius="1.5"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 창 어딘가에 마우스가 있을 때만 스크롤바 표시 -->
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- ─── 위쪽: 예정된 알람 (연한 파랑) ─── -->
        <Border Grid.Row="0" Background="#EDF4FC">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="UpcomingHeader"
                           Grid.Row="0"
                           Text="예정된 알람"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#1565C0"
                           Margin="16,14,16,8"/>

                <ScrollViewer x:Name="UpcomingScroll" Grid.Row="1" Style="{StaticResource OverlayScrollViewerStyle}">
                    <StackPanel x:Name="UpcomingList" Margin="12,0,12,12"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ─── 중간 구분선: 위아래로 드래그하면 구역 비율 조절 ─── -->
        <GridSplitter Grid.Row="1"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      Background="#CCCCCC"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS"/>

        <!-- ─── 아래쪽: 지난 알람 (연한 회색) ─── -->
        <Border Grid.Row="2" Background="#F3F3F3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,14,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CompletedHeader"
                               Grid.Column="0"
                               Text="지난 알람"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#616161"
                               VerticalAlignment="Center"/>

                    <Button x:Name="DeleteAllButton"
                            Grid.Column="1"
                            Content="전체삭제"
                            Style="{StaticResource DeleteButtonStyle}"
                            Click="DeleteAllButton_Click"/>
                </Grid>

                <ScrollViewer x:Name="CompletedScroll" Grid.Row="1" Style="{StaticResource OverlayScrollViewerStyle}">
                    <StackPanel x:Name="CompletedList" Margin="12,0,12,12"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>