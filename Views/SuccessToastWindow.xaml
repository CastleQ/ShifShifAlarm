<Window x:Class="EasyAlarm.Views.SuccessToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyAlarm Toast"
        Width="432" Height="64"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <!-- 테두리 없는 흰색 미니멀 카드 (은은한 그림자로만 존재감 표시) -->
    <Border Background="#FFFFFF"
            CornerRadius="12"
            Padding="20,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>

        <TextBlock x:Name="MessageText"
                   Text=""
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#2E7D32"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
    </Border>
</Window>