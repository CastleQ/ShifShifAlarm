<Window x:Class="EasyAlarm.Views.InputPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyAlarm"
        Width="480" Height="150"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border x:Name="OuterBorder"
            Background="#F5F5F5"
            CornerRadius="12"
            BorderThickness="2"
            BorderBrush="#CCCCCC"
            Padding="20,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>

        <!-- VerticalAlignment="Center": 내용물 묶음 전체를 창 세로 정중앙에 배치 -->
        <StackPanel VerticalAlignment="Center">

            <!-- 윗줄: 안내 문구 + 목록 버튼 (같은 폰트 크기) -->
            <Grid Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="⏰ 언제, 무엇을 알려드릴까요?"
                           FontSize="13"
                           Foreground="#888888"
                           VerticalAlignment="Center"/>

                <Button x:Name="ListButton"
                        Grid.Column="1"
                        Content="목록"
                        FontSize="13"
                        Padding="8,2"
                        Foreground="#888888"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ListButton_Click"/>
            </Grid>

            <!-- 입력칸 -->
            <TextBox x:Name="InputBox"
                     FontSize="18"
                     Padding="10,8"
                     BorderThickness="1"
                     BorderBrush="#DDDDDD"
                     Background="White"
                     InputMethod.PreferredImeState="On"
                     InputMethod.PreferredImeConversionMode="Native"
                     KeyDown="InputBox_KeyDown"/>

            <TextBlock x:Name="ErrorText"
                       Text=""
                       FontSize="12"
                       Foreground="#E53935"
                       Margin="4,6,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>